# PromptMill - Test image
# Runs lint, type check and the test suite. llama-cpp-python is deliberately
# absent: it is imported lazily inside the adapter and mocked in the tests, so
# the suite stays fast and needs no compiler.

FROM python:3.14-slim-trixie

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
    "gradio>=6.27.0,<7.0.0" \
    "huggingface_hub>=1.31.0,<2.0.0" \
    "pydantic>=2.13.0,<3.0.0" \
    "ruff>=0.16.7" \
    "mypy>=2.3.1" \
    "pytest>=9.1.1" \
    "pytest-cov>=7.1.0" \
    "httpx2>=2.13.0"

CMD ["pytest", "tests", "-q"]
