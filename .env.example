# PromptMill Environment Configuration
# Copy this file to .env and modify as needed. Every value has a default;
# the file is optional.

# Host port that docker compose publishes. The container itself always
# listens on 7610.
# PROMPTMILL_PORT=7610

# Server bind address. The Docker images already bind to 0.0.0.0 (a container
# port is only reachable through -p anyway). Outside Docker the default is
# 127.0.0.1.
# SERVER_HOST=127.0.0.1

# Where downloaded GGUF models are stored inside the container.
# MODELS_DIR=/app/models

# Logging Level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
